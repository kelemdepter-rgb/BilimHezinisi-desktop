{
  "name": "bilim-hezinisi",
  "version": "3.2.0",
  "description": "بىلىم خەزىنىسى - Uyghur Digital Library",
  "main": "main.js",
  "scripts": {
    "setup": "node setup-pdfjs.js",
    "postinstall": "electron-rebuild -f -w better-sqlite3 && node scripts/copy-dompurify.js && node scripts/copy-vendor.js",
    "fetch-quran": "node scripts/fetch-quran-data.js",
    "fetch-ocr-models": "node scripts/fetch-ocr-models.js",
    "build-spelldict": "node scripts/build-spelldict.mjs",
    "start": "electron .",
    "dev": "electron . --dev",
    "dist-win": "electron-builder --win --x64",
    "dist-mac": "electron-builder --mac",
    "dist-linux": "electron-builder --linux",
    "dist": "electron-builder --win --x64",
    "dist-store": "electron-builder --win appx --x64",
    "test": "electron tests/run.js",
    "check-syntax": "node tests/syntax-gate.js",
    "test-spelldict": "node scripts/test-spelldict.mjs"
  },
  "build": {
    "appId": "com.bilim.hezinisi",
    "productName": "Bilim Hezinisi",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "compression": "maximum",
    "removePackageScripts": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "بىلىم خەزىنىسى",
      "allowElevation": false,
      "perMachine": false,
      "runAfterFinish": true,
      "installerIcon": "assets/installer-icon.ico",
      "uninstallerIcon": "assets/installer-icon.ico",
      "installerHeaderIcon": "assets/installer-icon.ico"
    },
    "portable": {
      "artifactName": "BilimHezinisi-Portable-${version}.exe"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "files": [
      "main.js",
      "ai.js",
      "preload.js",
      "database.js",
      "library-sync.js",
      "backup.js",
      "ocr-postprocess.js",
      "src/**/*",
      "assets/ukijekran.ttf",
      "assets/icon.*",
      "assets/installer-icon.ico",
      "assets/pdfjs/**/*",
      "assets/fonts/**/*",
      "assets/seed/**/*",
      "src/quran.js",
      "src/quran.css",
      "src/notes.js",
      "src/notes.css",
      "src/ngram.js",
      "src/spellcheck.js",
      "assets/spellcheck/uyghur-dict.bin",
      "assets/spellcheck/uyghur_corrections.json",
      "assets/vendor/**/*",
      "assets/ocr/**/*",
      "scripts/**/*",
      "!scripts/build-spelldict.mjs",
      "!scripts/test-spelldict.mjs",
      "!scripts/lib/**/*",
      "!assets/spellcheck/raw/**/*",
      "!build/**/*",
      "!_to_delete/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*",
      "assets/ocr/**/*"
    ],
    "nodeGypRebuild": false,
    "copyright": "Copyright (c) 2026 Bilim Hezinisi",
    "appx": {
      "identityName": "BilimHezinisi.BilimHezinisi",
      "publisher": "CN=92DA40C5-9257-4E65-B590-0E8EF5BE2F1C",
      "publisherDisplayName": "Bilim Hezinisi",
      "applicationId": "BilimHezinisi",
      "displayName": "بىلىم خەزىنىسى",
      "backgroundColor": "#07161D",
      "languages": [
        "ug-arab",
        "en-US"
      ],
      "showNameOnTiles": false,
      "setBuildNumber": true,
      "artifactName": "BilimHezinisi-Store-${version}.appx"
    }
  },
  "keywords": [
    "uyghur",
    "library",
    "kutupxana",
    "arabic",
    "islamic"
  ],
  "author": "Bilim Hezinisi",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "pdfjs-dist": "3.11.174"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^11.10.0",
    "docx": "^8.5.0",
    "dompurify": "^3.4.1",
    "electron-window-state": "^5.0.3",
    "mammoth": "^1.6.0",
    "node-html-parser": "^6.1.13",
    "sql.js": "^1.10.0",
    "tesseract.js": "^5.0.0",
    "turndown": "^7.2.4",
    "word-extractor": "^1.0.4"
  },
  "homepage": "https://github.com/kelemdepter-rgb/BilimHezinisi-desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kelemdepter-rgb/BilimHezinisi-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/kelemdepter-rgb/BilimHezinisi-desktop/issues"
  }
}
